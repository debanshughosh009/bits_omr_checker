# ==============================================================================
# OMR Checker - Git Ignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Input Directories & Scan Files
# ------------------------------------------------------------------------------
# Root and nested input directories
input/*
!input/.gitkeep
inputs/
scans/
scan/
DD_Quiz1_CS/
*_Quiz*/
*Quiz*/

# Raw scan image & document files
*.jpg
*.jpeg
*.png
*.tif
*.tiff
*.bmp
*.pdf

# Preserve template definitions, overlays and documentation assets
!templates/*.png
!**/templates/*.png
!**/templates/*.json
!**/overlay.png
# the app's own icons
!packaging/*.png
!web/public/*.png
!web/dist/*.png
!docs/**
!*.md

# ------------------------------------------------------------------------------
# Output Directories & Result Files
# ------------------------------------------------------------------------------
# Root and nested output directories
output/*
!output/.gitkeep
outputs/
baseline_results/
overlays/
work/
_omr_work*/
temp/
tmp/

# Result spreadsheets and data exports
results.csv
Results_*.csv
score.csv
scores*.csv
*.xlsx
*.xls
*.csv.tmp

# Scoring answer keys
scoring/keys/*.json
!scoring/keys/.gitkeep

# ------------------------------------------------------------------------------
# Python & Environment Artifacts
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
!web/dist/
*.egg-info/

# Virtual Environments
venv/
.venv/
env/
.env

# ------------------------------------------------------------------------------
# IDE & Operating System Files
# ------------------------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
ehthumbs.db
# Local app data (SQLite database, uploaded scans, overlays)
data/

# Web app dependencies (web/dist is committed, so running needs only Python)
node_modules/

# Packaged app builds (build/ is ignored above)
release/
.venv-build/
template_1
template_2
template_3
